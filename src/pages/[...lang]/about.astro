---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prompt from '../../components/Prompt.astro';
import { langParams } from '../../i18n/paths.ts';
import { t } from '../../i18n/ui.ts';
import type { Lang } from '../../i18n/langs.ts';
import Flag from '../../components/Flag.astro';
import { bio, history, education, links } from '../../data/profile.ts';
import { person } from '../../lib/jsonld.ts';

export function getStaticPaths() {
  return langParams();
}
const { lang } = Astro.props as { lang: Lang };
---
<BaseLayout lang={lang} path="about/" section="about" title={`${t(lang, 'meta.aboutTitle')} — Noel Moreno Lemus`} description={t(lang, 'meta.aboutDescription')} jsonLd={person(Astro.site!)}>
  <Prompt dir="~">
    <Fragment slot="cmd">cat <span class="arg">about.md</span></Fragment>
  </Prompt>
  <div class="panes">
    <div class="pane">
      <div class="md">
        <h1 class="post-title"><span class="hash" aria-hidden="true"># </span>Noel Moreno Lemus</h1>
        {bio[lang].map((p) => <p>{p}</p>)}
      </div>
      <Prompt dir="~" bar={false}>
        <Fragment slot="cmd">cat <span class="arg">links.txt</span></Fragment>
        <ul class="log">{links.map((l) => <li><span class="when">{l.label}</span> <a href={l.href} rel="me">{l.href.replace(/^https?:\/\//, '')}</a></li>)}</ul>
      </Prompt>
    </div>
    <div class="pane">
      <Prompt dir="~" bar={false}>
        <Fragment slot="cmd">git log <span class="arg">--pretty='%ad %s' --date=short</span></Fragment>
        <ul class="log">{history.map((i) => <li><span class="when">{i.when}</span><span class="what"><Flag code={i.country} lang={lang} /><span>{i.what[lang]}</span></span></li>)}</ul>
      </Prompt>
      <Prompt dir="~" bar={false}>
        <Fragment slot="cmd">ls <span class="arg">education/</span></Fragment>
        <ul class="log">{education.map((i) => <li><span class="when">{i.when}</span><span class="what"><Flag code={i.country} lang={lang} /><span>{i.what[lang]}</span></span></li>)}</ul>
      </Prompt>
    </div>
  </div>
</BaseLayout>
<style>
  .panes { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; margin-top: 18px; }
  @media (min-width: 1000px) { .panes { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; } }
  .panes .md { margin-top: 0; }
  .log { list-style: none; margin: 0; padding: 0; }
  .log li { display: grid; grid-template-columns: 11ch minmax(0, 1fr); column-gap: 2ch; padding: 3px 0; overflow-wrap: anywhere; }
  .when { color: var(--key); }
  /* Wrapped lines align with the text, not under the flag. */
  .what { display: flex; align-items: flex-start; }
  .what :global(.flag) { margin-top: .38em; }
  :global(:root[data-mode='reader']) .panes { display: block; max-width: 700px; margin: 0 auto; }
  :global(:root[data-mode='reader']) .log li { font-family: var(--serif); font-size: 17px; }
</style>
