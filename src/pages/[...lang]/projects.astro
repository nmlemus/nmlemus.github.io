---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prompt from '../../components/Prompt.astro';
import { langParams } from '../../i18n/paths.ts';
import { t } from '../../i18n/ui.ts';
import type { Lang } from '../../i18n/langs.ts';
import { projects } from '../../data/projects.ts';

export function getStaticPaths() {
  return langParams();
}
const { lang } = Astro.props as { lang: Lang };
---
<BaseLayout lang={lang} path="projects/" section="projects" title={`${t(lang, 'meta.projectsTitle')} — Noel Moreno Lemus`} description={t(lang, 'meta.projectsDescription')}>
  <h1 class="sr-only">{t(lang, 'meta.projectsTitle')}</h1>
  <Prompt dir="~">
    <Fragment slot="cmd">ls -l <span class="arg">projects/</span></Fragment>
    <ul class="projects">
      {projects.map((p) => (
        <li class="card">
          <p class="meta"><span>{p.period}</span><span>{p.kind[lang]}</span></p>
          <h2 class="name">{p.url ? <a href={p.url}>{p.name}/</a> : `${p.name}/`}</h2>
          <p class="desc">{p.description[lang]}</p>
        </li>
      ))}
    </ul>
  </Prompt>
</BaseLayout>
<style>
  .projects { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr)); }
  .card { padding: 14px 16px; border: 1px solid var(--line); border-left: 2px solid var(--line); }
  .card:has(a):hover { border-left-color: var(--p10k-char); background: var(--bg-2); }
  .meta { display: flex; flex-wrap: wrap; gap: 0 2ch; color: var(--muted); font-size: 13px; }
  .meta span + span { color: var(--quote); }
  .name { font: 700 17px/1.4 var(--mono); color: var(--strong); margin: 4px 0 6px; }
  .desc { font: 400 16px/1.55 var(--serif); color: var(--prose); }
  :global(:root[data-mode='reader']) .projects { display: block; max-width: 700px; margin: 0 auto; }
  :global(:root[data-mode='reader']) .card { border: 0; border-bottom: 1px solid var(--line); padding: 18px 0; background: none; }
  :global(:root[data-mode='reader']) .name { font: 600 21px/1.3 var(--serif); }
  :global(:root[data-mode='reader']) .meta { font-family: var(--serif); font-size: 14px; }
</style>
